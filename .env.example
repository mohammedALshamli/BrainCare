# Copy to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=json

# PostgreSQL. Either provide DATABASE_URL or the POSTGRES_* variables.
DATABASE_URL=postgres://braincare:braincare@127.0.0.1:5432/braincare
# POSTGRES_DB=braincare
# POSTGRES_USER=braincare
# POSTGRES_PASSWORD=braincare
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# JWT
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Throttling
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=1000/hour
THROTTLE_AUTH_RATE=10/min
THROTTLE_PAIRING_GENERATE_RATE=10/hour
THROTTLE_PAIRING_REDEEM_RATE=10/min

# Pairing codes
PAIRING_CODE_TTL_MINUTES=10
PAIRING_CODE_MAX_FAILED_ATTEMPTS=5
PAIRING_CODE_FAILED_ATTEMPT_WINDOW_SECONDS=900
PAIRING_CODE_RETENTION_DAYS=7
# PAIRING_CODE_PEPPER=change-me-to-a-separate-long-random-value

# Push notifications / FCM. Leave disabled in development and tests.
FCM_ENABLED=false
# FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# FCM_TOKEN_ENCRYPTION_KEY=generate-with-Fernet.generate_key()
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_RETRY_MAX_SECONDS=3600
NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=300

# Production only
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
